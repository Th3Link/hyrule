{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Berlin",
  "flux": {
    "managerFilePatterns": [
      "/^(apps|infrastructure|clusters)/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^(apps|infrastructure|vms)/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Kubernetes component images in the Talos machine configs",
      "customType": "regex",
      "managerFilePatterns": [
        "/^talos/nodes/.+\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>registry\\.k8s\\.io/kube-(?:apiserver|controller-manager|scheduler|proxy)|ghcr\\.io/siderolabs/kubelet):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Talos installer image (Image Factory schematic) in the Talos machine configs",
      "customType": "regex",
      "managerFilePatterns": [
        "/^talos/nodes/.+\\.yaml$/"
      ],
      "matchStrings": [
        "image: factory\\.talos\\.dev/[a-z-]+-installer/[a-f0-9]{64}:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "KubeVirt / CDI release manifests referenced by URL",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/controllers/kubevirt/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>kubevirt/[^/]+)/releases/download/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Image tags in HelmRelease values, marked with '# renovate: image=<repo>'",
      "customType": "regex",
      "managerFilePatterns": [
        "/^(apps|infrastructure)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*image=(?<depName>\\S+)\\s*\\n\\s*tag:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Kubernetes: one PR per version, one minor at a time (talosctl upgrade-k8s cannot skip minors)",
      "matchPackageNames": [
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-scheduler",
        "registry.k8s.io/kube-proxy",
        "ghcr.io/siderolabs/kubelet"
      ],
      "groupName": "kubernetes",
      "separateMultipleMinor": true,
      "prBodyNotes": [
        "Merging only updates the configs in git. Roll out with `talosctl -n 192.168.178.234 upgrade-k8s --to <version>` (see talos/README.md)."
      ]
    },
    {
      "description": "Talos OS: one minor at a time",
      "matchPackageNames": [
        "siderolabs/talos"
      ],
      "groupName": "talos",
      "separateMultipleMinor": true,
      "prBodyNotes": [
        "Merging only updates the configs in git. Roll out node by node with `talosctl upgrade --image ...` (see talos/README.md)."
      ]
    },
    {
      "description": "KubeVirt and CDI together",
      "matchPackageNames": [
        "kubevirt/kubevirt",
        "kubevirt/containerized-data-importer"
      ],
      "groupName": "kubevirt"
    },
    {
      "description": "Longhorn, MetalLB, Flux: one minor at a time (no skipping minors on upgrade)",
      "matchPackageNames": [
        "longhorn",
        "metallb",
        "fluxcd/flux2"
      ],
      "separateMultipleMinor": true
    },
    {
      "description": "servercontainers/samba tags like a3.24.4-s4.23.8-r0 (Alpine version, then Samba version)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/servercontainers/samba"
      ],
      "versioning": "regex:^a(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-s4\\.(?<build>\\d+)\\.(?<revision>\\d+)-r\\d+$"
    },
    {
      "description": "Postgres major upgrades need a dump/restore or pg_upgrade",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "prBodyNotes": [
        "⚠️ Postgres major upgrade: the data directory is not compatible. Dump and restore (or pg_upgrade) before merging."
      ]
    },
    {
      "description": "Nextcloud app image and the backup CronJob image together; majors one at a time (Nextcloud cannot skip majors)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nextcloud",
        "docker.io/library/nextcloud"
      ],
      "groupName": "nextcloud image",
      "separateMultipleMajor": true
    }
  ]
}
